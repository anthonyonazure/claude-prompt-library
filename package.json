{
  "name": "claude-prompt-library",
  "version": "0.1.0",
  "description": "Production-ready Claude prompts with structured outputs and eval harness",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "mutation": "stryker run",
    "check": "bun run typecheck && bun run lint",
    "run": "tsx src/cli.ts",
    "eval": "tsx src/eval.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
